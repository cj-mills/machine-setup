# ~/.profile: executed by the command interpreter for login shells.
# This file is not read by bash(1), if ~/.bash_profile or ~/.bash_login
# exists.
# see /usr/share/doc/bash/examples/startup-files for examples.
# the files are located in the bash-doc package.

# the default umask is set in /etc/profile; for setting the umask
# for ssh logins, install and configure the libpam-umask package.
#umask 022

# if running bash
if [ -n "$BASH_VERSION" ]; then
    # include .bashrc if it exists
    if [ -f "$HOME/.bashrc" ]; then
	. "$HOME/.bashrc"
    fi
fi

# All PATH setup lives here (not in ~/.bashrc), so it runs once per login and
# every program started from the session inherits it.
# path_prepend adds a directory to the front of PATH only if it exists and
# isn't already there, so re-running this file never creates duplicates.
path_prepend() {
    case ":$PATH:" in
        *":$1:"*) ;;
        *) if [ -d "$1" ]; then PATH="$1:$PATH"; fi ;;
    esac
}

# Prepended in reverse priority order: the last one added wins lookups.
path_prepend "$HOME/.local/share/mise/shims"  # mise-managed tools (node, uv, aws-cli, ...); shims so GUI apps see them too
path_prepend "$HOME/bin"                      # user's private bin
path_prepend "$HOME/.local/bin"               # user's private bin (pipx, installers, own scripts)

unset -f path_prepend
export PATH
