#!/usr/bin/env bash
# Install mise-managed tools whenever the global mise config changes.
# config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
set -euo pipefail
if ! command -v mise >/dev/null 2>&1; then
  echo "mise is not installed; converge the system layer first (scripts/converge-system.sh)." >&2
  exit 1
fi
mise install
