#!/usr/bin/env python3
"""
Fetch GitHub repositories and format them as Markdown with links and descriptions.
"""

import requests
import sys
import argparse
import os


def get_user_repos(username, token=None, include_forks=False):
    """
    Fetch all repositories for a given GitHub username.
    
    Args:
        username: GitHub username
        token: Optional GitHub personal access token for higher rate limits
        include_forks: Whether to include forked repositories
    
    Returns:
        List of repository dictionaries
    """
    headers = {}
    if token:
        headers['Authorization'] = f'token {token}'
    
    all_repos = []
    page = 1
    per_page = 100  # Maximum allowed by GitHub API
    
    while True:
        url = f'https://api.github.com/users/{username}/repos'
        params = {
            'page': page,
            'per_page': per_page
        }
        
        response = requests.get(url, headers=headers, params=params)
        
        if response.status_code != 200:
            print(f"Error: {response.status_code} - {response.text}", file=sys.stderr)
            sys.exit(1)
        
        repos = response.json()
        
        if not repos:
            break
        
        all_repos.extend(repos)
        page += 1
    
    # Filter out forks if requested
    if not include_forks:
        all_repos = [repo for repo in all_repos if not repo['fork']]
    
    return all_repos


def get_org_repos(org_name, token=None, include_forks=False):
    """
    Fetch all repositories for a given GitHub organization.
    
    Args:
        org_name: GitHub organization name
        token: Optional GitHub personal access token for higher rate limits
        include_forks: Whether to include forked repositories
    
    Returns:
        List of repository dictionaries
    """
    headers = {}
    if token:
        headers['Authorization'] = f'token {token}'
    
    all_repos = []
    page = 1
    per_page = 100
    
    while True:
        url = f'https://api.github.com/orgs/{org_name}/repos'
        params = {
            'page': page,
            'per_page': per_page
        }
        
        response = requests.get(url, headers=headers, params=params)
        
        if response.status_code != 200:
            print(f"Error: {response.status_code} - {response.text}", file=sys.stderr)
            sys.exit(1)
        
        repos = response.json()
        
        if not repos:
            break
        
        all_repos.extend(repos)
        page += 1
    
    # Filter out forks if requested
    if not include_forks:
        all_repos = [repo for repo in all_repos if not repo['fork']]
    
    return all_repos


def sort_repos(repos, sort_by='updated', reverse=True):
    """
    Sort repositories by specified field.
    
    Args:
        repos: List of repository dictionaries
        sort_by: Field to sort by ('updated', 'created', 'pushed', 'name', 'stars')
        reverse: Sort in descending order if True
    
    Returns:
        Sorted list of repositories
    """
    if sort_by == 'name':
        return sorted(repos, key=lambda r: r['name'].lower(), reverse=reverse)
    elif sort_by == 'stars':
        return sorted(repos, key=lambda r: r['stargazers_count'], reverse=reverse)
    elif sort_by in ['updated', 'created', 'pushed']:
        # These are datetime strings, sort them as strings (ISO format sorts correctly)
        return sorted(repos, key=lambda r: r.get(f'{sort_by}_at', ''), reverse=reverse)
    else:
        return repos


def repos_to_markdown(repos, format_style='list', include_date=False):
    """
    Convert repository data to Markdown format.
    
    Args:
        repos: List of repository dictionaries from GitHub API
        format_style: 'list' for bullet points, 'table' for table format, 'numbered' for numbered list
        include_date: Include last updated date in output
    
    Returns:
        String containing Markdown-formatted repository list
    """
    if not repos:
        return "No repositories found."
    
    def format_date(date_string):
        """Format ISO date string to readable format."""
        if not date_string:
            return ''
        # Convert 2024-01-15T10:30:00Z to 2024-01-15
        return date_string.split('T')[0]
    
    markdown = ""
    
    if format_style == 'table':
        if include_date:
            markdown = "| Repository | Description | Last Pushed |\n"
            markdown += "|------------|-------------|-------------|\n"
            for repo in repos:
                name = repo['name']
                url = repo['html_url']
                description = repo['description'] or '*No description*'
                # Escape pipe characters in description for table format
                description = description.replace('|', '\\|')
                date = format_date(repo.get('pushed_at', ''))
                markdown += f"| [{name}]({url}) | {description} | {date} |\n"
        else:
            markdown = "| Repository | Description |\n"
            markdown += "|------------|-------------|\n"
            for repo in repos:
                name = repo['name']
                url = repo['html_url']
                description = repo['description'] or '*No description*'
                # Escape pipe characters in description for table format
                description = description.replace('|', '\\|')
                markdown += f"| [{name}]({url}) | {description} |\n"
    
    elif format_style == 'numbered':
        for i, repo in enumerate(repos, 1):
            name = repo['name']
            url = repo['html_url']
            description = repo['description'] or '*No description*'
            if include_date:
                date = format_date(repo.get('pushed_at', ''))
                markdown += f"{i}. **[{name}]({url})** - {description} *(Last pushed: {date})*\n"
            else:
                markdown += f"{i}. **[{name}]({url})** - {description}\n"
    
    else:  # default to 'list'
        for repo in repos:
            name = repo['name']
            url = repo['html_url']
            description = repo['description'] or '*No description*'
            if include_date:
                date = format_date(repo.get('pushed_at', ''))
                markdown += f"- **[{name}]({url})** - {description} *(Last pushed: {date})*\n"
            else:
                markdown += f"- **[{name}]({url})** - {description}\n"
    
    return markdown


def repos_to_markdown_detailed(repos):
    """
    Convert repository data to detailed Markdown format with additional information.
    
    Args:
        repos: List of repository dictionaries from GitHub API
    
    Returns:
        String containing detailed Markdown-formatted repository list
    """
    if not repos:
        return "No repositories found."
    
    def format_date(date_string):
        """Format ISO date string to readable format."""
        if not date_string:
            return 'Unknown'
        # Convert 2024-01-15T10:30:00Z to 2024-01-15
        return date_string.split('T')[0]
    
    markdown = "# GitHub Repositories\n\n"
    
    for repo in repos:
        name = repo['name']
        url = repo['html_url']
        description = repo['description'] or '*No description*'
        stars = repo['stargazers_count']
        forks = repo['forks_count']
        language = repo['language'] or 'Not specified'
        updated = format_date(repo.get('updated_at', ''))
        created = format_date(repo.get('created_at', ''))
        
        markdown += f"## [{name}]({url})\n\n"
        markdown += f"{description}\n\n"
        markdown += f"- **Language:** {language}\n"
        markdown += f"- **Stars:** {stars} ⭐\n"
        markdown += f"- **Forks:** {forks} 🍴\n"
        markdown += f"- **Last Pushed:** {format_date(repo.get('pushed_at', ''))}\n"
        markdown += f"- **Last Updated:** {updated}\n"
        markdown += f"- **Created:** {created}\n"
        
        if repo['homepage']:
            markdown += f"- **Homepage:** {repo['homepage']}\n"
        
        if repo['topics']:
            topics = ', '.join([f"`{topic}`" for topic in repo['topics']])
            markdown += f"- **Topics:** {topics}\n"
        
        markdown += "\n---\n\n"
    
    return markdown


def main():
    parser = argparse.ArgumentParser(
        description='Fetch GitHub repositories and convert to Markdown format',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  # Fetch repos sorted by last pushed (default)
  python github_repos_to_markdown.py octocat
  
  # Sort by stars instead
  python github_repos_to_markdown.py username --sort stars
  
  # Sort by name alphabetically
  python github_repos_to_markdown.py username --sort name
  
  # Include last pushed dates in output
  python github_repos_to_markdown.py username --show-dates
  
  # Fetch repos for an organization
  python github_repos_to_markdown.py --org github
  
  # Use a personal access token (recommended for higher rate limits)
  python github_repos_to_markdown.py username --token YOUR_GITHUB_TOKEN
  
  # Save to file
  python github_repos_to_markdown.py username -o my_repos.md
  
  # Use table format with dates
  python github_repos_to_markdown.py username --format table --show-dates
  
  # Include detailed information
  python github_repos_to_markdown.py username --detailed
  
  # Include forked repositories
  python github_repos_to_markdown.py username --include-forks
  
  # Sort by metadata updates (stars, description changes, etc.) oldest first
  python github_repos_to_markdown.py username --sort updated --ascending

Environment Variables:
  GITHUB_TOKEN: You can set your GitHub token as an environment variable
                instead of passing it via command line
        """)
    
    parser.add_argument('name', help='GitHub username or organization name')
    parser.add_argument('--org', action='store_true', 
                       help='Treat name as organization instead of user')
    parser.add_argument('--token', help='GitHub personal access token (or set GITHUB_TOKEN env var)')
    parser.add_argument('-o', '--output', help='Output file (default: print to stdout)')
    parser.add_argument('--format', choices=['list', 'table', 'numbered'], 
                       default='list', help='Output format (default: list)')
    parser.add_argument('--detailed', action='store_true', 
                       help='Include detailed information (stars, forks, language, etc.)')
    parser.add_argument('--include-forks', action='store_true', 
                       help='Include forked repositories')
    parser.add_argument('--sort', choices=['updated', 'created', 'pushed', 'name', 'stars'], 
                       default='pushed', help='Sort repositories by (default: pushed). "updated" = metadata changes, "pushed" = last commit')
    parser.add_argument('--ascending', action='store_true', 
                       help='Sort in ascending order instead of descending')
    parser.add_argument('--show-dates', action='store_true', 
                       help='Include last pushed date in output')
    
    args = parser.parse_args()
    
    # Get token from environment variable if not provided
    token = args.token or os.environ.get('GITHUB_TOKEN')
    
    # Fetch repositories
    if args.org:
        repos = get_org_repos(args.name, token, args.include_forks)
    else:
        repos = get_user_repos(args.name, token, args.include_forks)
    
    # Sort repositories
    repos = sort_repos(repos, args.sort, reverse=not args.ascending)
    
    # Convert to markdown
    if args.detailed:
        markdown_output = repos_to_markdown_detailed(repos)
    else:
        markdown_output = repos_to_markdown(repos, args.format, include_date=args.show_dates)
    
    # Output results
    if args.output:
        with open(args.output, 'w', encoding='utf-8') as f:
            f.write(markdown_output)
        print(f"Successfully saved {len(repos)} repositories to {args.output}")
        if args.sort == 'pushed':
            print(f"Repositories sorted by: last pushed ({'oldest first' if args.ascending else 'most recent first'})")
        else:
            print(f"Repositories sorted by: {args.sort} ({'ascending' if args.ascending else 'descending'})")
    else:
        print(markdown_output)
        print(f"\n# Total repositories: {len(repos)}", file=sys.stderr)
        if args.sort == 'pushed':
            print(f"# Sorted by: last pushed ({'oldest first' if args.ascending else 'most recent first'})", file=sys.stderr)
        else:
            print(f"# Sorted by: {args.sort} ({'ascending' if args.ascending else 'descending'})", file=sys.stderr)


if __name__ == '__main__':
    main()
