#!/usr/bin/env python3
import argparse
import re
import unicodedata


def slugify(value: str) -> str:
    """Converts a string to a slug-friendly format."""
    # Normalize string, remove accents
    value = unicodedata.normalize('NFKD', value).encode('ascii', 'ignore').decode('ascii')
    # Remove non-word characters
    value = re.sub(r'[^\w\s-]', '', value).strip().lower()
    # Replace spaces and repeated hyphens with a single hyphen
    slug = re.sub(r'[-\s]+', '-', value)
    return slug


def main():
    parser = argparse.ArgumentParser(description='Convert a string into a slug.')
    parser.add_argument('string', type=str, help='The string to slugify')

    args = parser.parse_args()
    result = slugify(args.string)

    print(result)


if __name__ == '__main__':
    main()
