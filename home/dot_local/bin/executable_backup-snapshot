#!/usr/bin/env bash
# Snapshot what can't be re-obtained onto the backup drive, keeping recent history.
#
# Each run writes snapshots/YYYY-MM-DD/, a plain browsable copy; unchanged files are hard
# links to the previous snapshot, so they take no extra space. History is the point: a
# plain mirror would copy an accidental deletion over the backup at the next run.
#
# One snapshot a day, so a timer catching up after boot can't add another. `--again` takes
# a further one on the same day, as snapshots/YYYY-MM-DD-HHMMSS/, for a run that has to
# include today's changes (e.g. right before reinstalling).
#
# What to copy is the machine's own policy, so it lives outside this script, in
# $CONFIG/sources: one line per source, `source|path inside a snapshot|filter`, where the
# optional filter is a file in $CONFIG of rsync filter rules (see "FILTER RULES" in
# rsync(1)). Blank lines and lines starting with # are skipped.
#
# Interim protection against a failed drive or a mistake.
set -euo pipefail

BACKUP_ROOT=/mnt/backup
KEEP=8
CONFIG="${BACKUP_SNAPSHOT_CONFIG:-$HOME/.config/backup-snapshot}"

snapshots() {  # dated snapshot directories, oldest first
  find "$BACKUP_ROOT/snapshots" -mindepth 1 -maxdepth 1 -type d -name '20[0-9][0-9]-*' | sort
}

sources() {  # the source lines of $CONFIG/sources
  grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$CONFIG/sources"
}

copy() {  # source, relative path, filter file (may be empty), previous snapshot (may be empty)
  local src="$1" rel="$2" filter="$3" previous="$4" partial="$BACKUP_ROOT/snapshots/.partial"
  # --delete-excluded: a run resumed from .partial drops what the filter now excludes.
  local opts=(-aH --delete --delete-excluded) code=0
  [[ -n "$filter" ]] && opts+=("--filter=merge $CONFIG/$filter")
  [[ -n "$previous" && -d "$previous/$rel" ]] && opts+=("--link-dest=$previous/$rel")
  mkdir -p "$partial/$rel"
  rsync "${opts[@]}" "$src/" "$partial/$rel/" || code=$?
  # 24: files vanished during the copy, normal for live data.
  [[ "$code" == 0 || "$code" == 24 ]]
}

prune() {
  local old
  snapshots | head -n "-$KEEP" | while read -r old; do
    # Only directories: files are hard links shared with the snapshots being kept.
    find "$old" -type d ! -perm -u+w -exec chmod u+w {} +
    rm -rf "${old:?}"
    echo "pruned $(basename "$old")"
  done
}

main() {
  local again=false
  case "${1:-}" in
    "") ;;
    --again) again=true ;;
    *) echo "usage: backup-snapshot [--again]" >&2; exit 2 ;;
  esac

  local today final previous entry src rel filter entries

  # Refuse without the drive: otherwise this would fill the root filesystem.
  mountpoint -q "$BACKUP_ROOT" || { echo "error: $BACKUP_ROOT is not mounted" >&2; exit 1; }
  [[ -r "$CONFIG/sources" ]] || { echo "error: $CONFIG/sources is missing" >&2; exit 1; }
  mapfile -t entries < <(sources)
  for entry in "${entries[@]}"; do
    IFS='|' read -r src rel filter <<< "$entry"
    [[ -d "$src" ]] || { echo "error: source $src is missing" >&2; exit 1; }
    [[ -z "$filter" || -r "$CONFIG/$filter" ]] || { echo "error: filter $CONFIG/$filter is missing" >&2; exit 1; }
  done

  today="$(date +%F)"
  final="$BACKUP_ROOT/snapshots/$today"
  mkdir -p "$BACKUP_ROOT/snapshots"
  # A first snapshot takes hours, so a run can overlap the timer; only one may use .partial.
  exec 9>"$BACKUP_ROOT/snapshots/.lock"
  flock -n 9 || { echo "error: another snapshot is running" >&2; exit 1; }
  if [[ -e "$final" ]]; then
    "$again" || { echo "snapshot $today already exists"; exit 0; }
    final+="-$(date +%H%M%S)"
  fi

  previous="$(snapshots | tail -n 1)"
  for entry in "${entries[@]}"; do
    IFS='|' read -r src rel filter <<< "$entry"
    copy "$src" "$rel" "$filter" "$previous"
    echo "copied $rel"
  done

  # Only a complete snapshot gets a date; an interrupted run resumes from .partial.
  mv "$BACKUP_ROOT/snapshots/.partial" "$final"
  prune
  echo "snapshot $(basename "$final") complete;$(snapshots | wc -l) kept, $(df -h --output=avail "$BACKUP_ROOT" | tail -n 1 | tr -d ' ') free"
}

main "$@"; exit
