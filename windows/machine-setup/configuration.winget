# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2
#
# Windows workstation configuration (WinGet Configuration, schema 0.2).
# Decisions and rationale: inventory/windows-review.md and docs/design.md.
#
# Apply from an elevated terminal:
#   winget configure -f C:\machine-setup\configuration.winget
#
# DRAFT: package IDs marked "verify" are expected IDs not yet confirmed against the
# winget catalog; the test VM run confirms or corrects them.
properties:
  configurationVersion: 0.2.0

  assertions:
    - resource: Microsoft.Windows.Developer/OsVersion
      directives:
        description: Windows 11
        allowPrerelease: true
      settings:
        MinVersion: '10.0.22000'

  resources:
    # --- Security -----------------------------------------------------------------
    # UAC "Always notify" (prompt on the secure desktop for every elevation).
    - resource: PSDscResources/Registry
      id: uac-consent-admin
      directives:
        description: UAC always notify (admin consent prompt)
        securityContext: elevated
        allowPrerelease: true
      settings:
        Key: HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System
        ValueName: ConsentPromptBehaviorAdmin
        ValueType: Dword
        ValueData: '2'
        Force: true
    - resource: PSDscResources/Registry
      id: uac-secure-desktop
      directives:
        description: UAC prompts on the secure desktop
        securityContext: elevated
        allowPrerelease: true
      settings:
        Key: HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System
        ValueName: PromptOnSecureDesktop
        ValueType: Dword
        ValueData: '1'
        Force: true

    # --- Windows features -----------------------------------------------------------
    - resource: PSDscResources/WindowsOptionalFeature
      id: windows-sandbox
      directives:
        description: Windows Sandbox
        securityContext: elevated
        allowPrerelease: true
      settings:
        Name: Containers-DisposableClientVM
        Ensure: Present
    - resource: PSDscResources/WindowsOptionalFeature
      id: work-folders-off
      directives:
        description: Work Folders client (unused)
        securityContext: elevated
        allowPrerelease: true
      settings:
        Name: WorkFolders-Client
        Ensure: Absent

    # --- Applications ---------------------------------------------------------------
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: brave
      directives: { description: Brave, securityContext: elevated }
      settings: { id: Brave.Brave, source: winget }  # verify
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: chrome
      directives: { description: Google Chrome, securityContext: elevated }
      settings: { id: Google.Chrome, source: winget }  # verify
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: firefox
      directives: { description: Firefox, securityContext: elevated }
      settings: { id: Mozilla.Firefox, source: winget }  # verify
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: 1password
      directives: { description: 1Password, securityContext: elevated }
      settings: { id: AgileBits.1Password, source: winget }  # verify
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: 1password-cli
      directives: { description: 1Password CLI, securityContext: elevated }
      settings: { id: AgileBits.1Password.CLI, source: winget }  # verify
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: claude
      directives: { description: Claude Desktop, securityContext: elevated }
      settings: { id: Anthropic.Claude, source: winget }  # verify
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: typora
      directives: { description: Typora, securityContext: elevated }
      settings: { id: appmakes.Typora, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: blender
      directives: { description: Blender 5.2 LTS (matches Linux), securityContext: elevated }
      settings: { id: BlenderFoundation.Blender, source: winget, version: 5.2.2 }  # verify version string
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: vlc
      directives: { description: VLC, securityContext: elevated }
      settings: { id: VideoLAN.VLC, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: powertoys
      directives: { description: PowerToys, securityContext: elevated }
      settings: { id: Microsoft.PowerToys, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: wiztree
      directives: { description: WizTree, securityContext: elevated }
      settings: { id: AntibodySoftware.WizTree, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: pia
      directives: { description: Private Internet Access, securityContext: elevated }
      settings: { id: PrivateInternetAccess.PrivateInternetAccess, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: steam
      directives: { description: Steam, securityContext: elevated }
      settings: { id: Valve.Steam, source: winget }

    # --- Development ----------------------------------------------------------------
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: git
      directives: { description: Git, securityContext: elevated }
      settings: { id: Git.Git, source: winget }  # verify
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: github-desktop
      directives: { description: GitHub Desktop, securityContext: elevated }
      settings: { id: GitHub.GitHubDesktop, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: vscode
      directives: { description: VS Code, securityContext: elevated }
      settings: { id: Microsoft.VisualStudioCode, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: cmake
      directives: { description: CMake, securityContext: elevated }
      settings: { id: Kitware.CMake, source: winget }  # verify
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: miniforge
      directives: { description: Miniforge (conda), securityContext: elevated }
      settings: { id: CondaForge.Miniforge3, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: mise
      directives: { description: mise (Node, uv and other per-user tools), securityContext: elevated }
      settings: { id: jdx.mise, source: winget }  # verify
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: wsl
      directives: { description: WSL, securityContext: elevated }
      settings: { id: Microsoft.WSL, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: docker-desktop
      directives: { description: Docker Desktop (WSL2 backend), securityContext: elevated }
      settings: { id: Docker.DockerDesktop, source: winget }  # verify
      dependsOn: [wsl]
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: cuda
      directives: { description: CUDA toolkit, securityContext: elevated }
      settings: { id: Nvidia.CUDA, source: winget }  # verify; pin a version once a project needs one
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: unity-hub
      directives: { description: Unity Hub, securityContext: elevated }
      settings: { id: Unity.UnityHub, source: winget }  # verify
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: epic-launcher
      directives: { description: Epic Games Launcher (Unreal Engine), securityContext: elevated }
      settings: { id: EpicGames.EpicGamesLauncher, source: winget }  # verify

    # Visual Studio and its workloads are added after the first VM run confirms the
    # current product/channel IDs for Microsoft.VisualStudio.DSC/VSComponents.
    # Not via winget: Samsung Magician, NVIDIA App, ArtCraft (vendor installers).
